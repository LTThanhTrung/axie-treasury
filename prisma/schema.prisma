// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Test {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String
}

model OverviewData {
  id   String @id @default(auto()) @map("_id") @db.ObjectId

  date String

  AXS  Float
  RON  Float
  USDC Float
  WETH Float

  @@map("overviewData")
}

model TypeData {
  id String @id @map("_id")

  Breeding    Json?
  Core        Json?
  Marketplace Json?
  Origins     Json?
  Other       Json?
  Pack        Json?
  bAXS        Json?

  @@map("typeData")
}

model StakingAXS {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  date      String
  hour      String
  timestamp Int
  axs_total Float

  @@map("stakingAXS")
}

model SumAXS {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  Forge         Float?
  Evolve        Float?
  Other         Float?
  bAXS          Float? @map("bAXS Fee")
  Breeding      Float?
  AtiaRestore   Float? @map("Atia's Restore")
  RunesCharms   Float? @map("Runes & Charms")
  Ascend        Float?
  absoluteTotal Float? @map("absolute_total")

  @@map("sumAXS")
}

model DailyAXS {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  date          String
  Forge         Float?
  Evolve        Float?
  Other         Float?
  bAXSFee       Float?  @map("bAXS Fee")
  Breeding      Float?
  AtiaRestore   Float?  @map("Atia's Restore")
  RunesCharms   Float?  @map("Runes & Charms")
  Ascend        Float?

  @@map("dailyAXS")
}