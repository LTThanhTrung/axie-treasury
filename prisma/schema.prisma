// This is your Prisma schema file for PostgreSQL,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OverviewData {
  id   String @id @default(dbgenerated("gen_random_uuid()::text"))
  date String @unique

  AXS  Float  @default(0)
  RON  Float  @default(0)
  USDC Float  @default(0)
  WETH Float  @default(0)

  @@map("overviewData")
}

model TypeData {
  id String @id

  Breeding    Json?
  Core        Json?
  Marketplace Json?
  Origins     Json?
  Other       Json?
  Pack        Json?
  bAXS        Json?

  @@map("typeData")
}

model StakingAXS {
  id        String @id @default(dbgenerated("gen_random_uuid()::text"))
  date      String
  hour      String
  timestamp BigInt
  axs_total Float

  @@map("stakingAXS")
}

model SumAXS {
  id            String    @id
  Forge         Float?    @default(0)
  Evolve        Float?    @default(0)
  Other         Float?    @default(0)
  bAXS          Float?    @map("bAXS Fee") @default(0)
  Breeding      Float?    @default(0)
  AtiaRestore   Float?    @map("Atia's Restore") @default(0)
  RunesCharms   Float?    @map("Runes & Charms") @default(0)
  Ascend        Float?    @default(0)
  absoluteTotal Float?    @map("absolute_total") @default(0)
  last_update   DateTime?

  @@map("sumAXS")
}

model DailyAXS {
  id          String  @id @default(dbgenerated("gen_random_uuid()::text"))
  date        String  @unique
  Forge       Float?  @default(0)
  Evolve      Float?  @default(0)
  Other       Float?  @default(0)
  bAXSFee     Float?  @map("bAXS Fee") @default(0)
  Breeding    Float?  @default(0)
  AtiaRestore Float?  @map("Atia's Restore") @default(0)
  RunesCharms Float?  @map("Runes & Charms") @default(0)
  Ascend      Float?  @default(0)

  @@map("dailyAXS")
}

model SumBAXS {
  id            String    @id
  Forge         Float?    @default(0)
  Evolve        Float?    @default(0)
  bAXSFee       Float?    @map("bAXS Fee") @default(0)
  Breeding      Float?    @default(0)
  AtiaRestore   Float?    @map("Atia's Restore") @default(0)
  RunesCharms   Float?    @map("Runes & Charms") @default(0)
  Ascend        Float?    @default(0)
  absoluteTotal Float?    @map("absolute_total") @default(0)
  last_update   DateTime?

  @@map("BAXSsum")
}

model DailyBAXS {
  id          String  @id @default(dbgenerated("gen_random_uuid()::text"))
  date        String  @unique
  Forge       Float?  @default(0)
  Evolve      Float?  @default(0)
  bAXSFee     Float?  @map("bAXS Fee") @default(0)
  Breeding    Float?  @default(0)
  AtiaRestore Float?  @map("Atia's Restore") @default(0)
  RunesCharms Float?  @map("Runes & Charms") @default(0)
  Ascend      Float?  @default(0)

  @@map("BAXSdaily")
}

model CirculatingSupply {
  id                 String @id @default(dbgenerated("gen_random_uuid()::text"))
  circulating_supply Float
  datetime           String
  timestamp          BigInt

  @@map("circulatingSupply")
}