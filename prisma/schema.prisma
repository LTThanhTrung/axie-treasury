// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Test {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String
}

model OverviewData {
  id   String @id @default(auto()) @map("_id") @db.ObjectId

  date String

  AXS  Float
  RON  Float
  USDC Float
  WETH Float

  @@map("overviewData")
}

model TypeData {
  id String @id @map("_id")

  Breeding    Json?
  Core        Json?
  Marketplace Json?
  Origins     Json?
  Other       Json?
  Pack        Json?
  bAXS        Json?

  @@map("typeData")
}